# csARM - null-guard the tier2 connect-path registrars.
#
# Tombstone (run 41311004467, both x86_64 and SwiftShader boots):
#   Fatal signal 11 (SIGSEGV), fault addr 0x0, SDLThread
#     #00 libtier2.so CBaseResourcePrecacher::RegisterAll()+27
#     #01 libfilesystem_stdio.so CTier2AppSystem<IQueuedLoader,0>::Connect()+52
#
# Valve links tier1+tier2 STATICALLY into every DLL, so each module's
# ConnectTier2Libraries -> RegisterAll()/Install() binds to ITS OWN copy of
# g_pPrecacheSystem / g_pResourceSystem (filled by that module's
# ConnectInterfaces).  In csARM tier2 is a SHARED lib: a module whose
# ConnectTier2Libraries copy runs (handed in per-module as an object) still
# resolves RegisterAll/Install through libtier2.so, whose registry copies are
# NEVER filled (nothing runs ConnectInterfaces inside libtier2.so) -> the
# virtual call derefs NULL.
#
# Primary fix: build/link.sh hands tier2_resourceprecacher.cpp.o and
# tier2_schemaclassbinding.cpp.o to every app-system module (local binding,
# Valve-faithful per-module registration).  This diff is the belt: the
# libtier2.so-resident copies stay inert instead of crashing if any binding
# path still resolves remotely.
diff --git a/tier2/resourceprecacher.cpp b/tier2/resourceprecacher.cpp
index 48c8552..4f0ef3b 100644
--- a/tier2/resourceprecacher.cpp
+++ b/tier2/resourceprecacher.cpp
@@ -15,6 +15,13 @@ CBaseResourcePrecacher *CBaseResourcePrecacher::sm_pFirst[PRECACHE_SYSTEM_COUNT]
 //-----------------------------------------------------------------------------
 void CBaseResourcePrecacher::RegisterAll()
 {
+	// csARM: the libtier2.so-resident copy of this function reads libtier2's
+	// own g_pPrecacheSystem, which is never filled (libtier2 is not an app
+	// system; nothing calls ConnectInterfaces inside it).  Every real module
+	// carries a local RegisterAll via the link.sh tier-connect hand-out; this
+	// guard only keeps the remote-binding path inert instead of SIGSEGV.
+	if ( !g_pPrecacheSystem )
+		return;
 	for ( int iSystem = 0; iSystem < PRECACHE_SYSTEM_COUNT; iSystem++ )
 	{
 		g_pPrecacheSystem->Register( sm_pFirst[iSystem], (PrecacheSystem_t) iSystem );
diff --git a/tier2/schemaclassbinding.cpp b/tier2/schemaclassbinding.cpp
index 08dadeb..b2f1097 100644
--- a/tier2/schemaclassbinding.cpp
+++ b/tier2/schemaclassbinding.cpp
@@ -17,6 +17,11 @@ CSchemaClassBindingBase *CSchemaClassBindingBase::sm_pClassBindingList;
 
 void CSchemaClassBindingBase::Install()
 {
+	// csARM: same per-.so registry-copy rationale as CBaseResourcePrecacher::
+	// RegisterAll (see patches/extras/csarm_tier2_connect.diff header).  The
+	// libtier2.so copy of g_pResourceSystem is never filled; guard it.
+	if ( !g_pResourceSystem )
+		return;
 	for ( CSchemaClassBindingBase *pBinding = sm_pClassBindingList; pBinding; pBinding = pBinding->m_pNextBinding )
 	{
 		g_pResourceSystem->InstallSchemaClassBinding( pBinding );
