<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.csarm.port"
    android:versionCode="2"
    android:versionName="0.2">

    <!-- targetSdk 28: keeps legacy execmem (JIT) allowed for software renderers
         (SwiftShader/Subzero) on Android 10+; minSdk 24 = Android 7.0+ -->
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="28" />
    <!-- round 41: without INTERNET, Android denies socket() with EPERM even for
         loopback - the run #176 console showed "NET_OpenSocket: socket failed:
         Operation not permitted" and the run #177 client retried
         "Sending connect to 127.0.0.1:27015 via UDP" 30 times and died because
         the server could only get a fake socket handle.  A listen server needs
         real UDP sockets on 127.0.0.1 even fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- GL NOT required: the port must boot and run even without HW acceleration -->
    <uses-feature android:glEsVersion="0x00020000" android:required="false" />

    <application
        android:label="csARM"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="false"
        android:debuggable="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <!-- debuggable: CI stages game content into filesDir via `adb run-as`
             (draft release game-content -> /data/local/tmp -> files/cstrike) -->
        <!-- full engine launcher (SDL2 glue -> libmain -> LauncherMain) -->
        <activity android:name=".CSARMActivity"
                  android:exported="true"
                  android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- library-load + GLES visual test (CI) -->
        <activity android:name=".MainActivity" android:exported="true">
        </activity>
    </application>
</manifest>
